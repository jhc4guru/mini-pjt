# 복사해서 .env로 만들고 값을 채운다. .env는 git에 올리지 않는다(.gitignore).
# 이 키들은 Bedrock(LLM·임베딩) 호출 전용이다. 실행기(mock)에는 절대 전달하지 않는다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Bedrock 모델 ID (역할별). 코드에 박지 않고 여기서만 읽는다. 계정에서 사용할 수 있는 ID로 채운다.
MAIN_MODEL=us.anthropic.claude-sonnet-4-6
SUB_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
READ_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# 선택: 임베딩 모델 (기본값 amazon.titan-embed-text-v2:0)
# EMBED_MODEL=

# 선택: 계획 조사 방식 (기본 batch = 일괄 조사 + 단계별 도구 호출 예산 + 시나리오, loop = 모델이 도구를 하나씩 호출하던 이전 방식, D-69·D-73). 가드·한도를 켜고 끄는 값이 아니다
# PLANNER_MODE=batch

# 선택: 관측 (기본 local. langfuse는 개발 단계에서만, 마스킹된 데이터만 전송)
# TRACE_BACKEND=local
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
